              "type": "string"
            },
            {
              "id": "d5303ee3-0eff-4bca-a144-a9296d7acad6",
              "name": "exportedAt",
              "value": "={{ $json.processedAt }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "d7cc0eeb-d8ff-4f38-a310-9b0000322133",
      "name": "Format Final CRM and Sheets Payload",
