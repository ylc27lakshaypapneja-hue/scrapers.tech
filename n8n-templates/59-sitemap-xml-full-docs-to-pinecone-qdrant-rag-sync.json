              "type": "number"
            },
            {
              "id": "32f41141-834f-455b-afe6-c04f70ab976d",
              "name": "tier",
              "value": "={{ $json.priorityTier }}",
              "type": "string"
            },
            {
              "id": "4882c7e9-64c2-4019-a15e-1b2f25cbd2cb",
              "name": "exportedAt",
              "value": "={{ $json.processedAt }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "ea046a6c-aa41-4874-a9e3-04a9cce9109e",
      "name": "Format Final CRM and Sheets Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
