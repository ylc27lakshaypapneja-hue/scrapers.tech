            "version": 2
          },
          "conditions": [
            {
              "id": "34781c3f-37c1-4ec8-a421-bb530d558f6d",
              "leftValue": "={{ $json.verifiedStatus }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
