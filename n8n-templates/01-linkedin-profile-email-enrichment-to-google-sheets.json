      },
      "id": "ee270a22-6eba-4037-ac86-db0e13c44fbb",
      "name": "Run Apify LinkedIn Profile & Email Scraper No Cookies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        460
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "f3e552b3-b2ab-41d2-a8d3-9cc63cadf290",
              "leftValue": "={{ $json.verifiedStatus ?? true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "4847e486-e8d2-45c7-a5d3-d09ffd02a529",
      "name": "Filter Verified Records",
