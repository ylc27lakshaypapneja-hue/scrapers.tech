            {
              "id": "cc60a06f-0bdf-46c4-ae27-0fe684b71f67",
              "name": "tier",
              "value": "={{ $json.priorityTier }}",
              "type": "string"
            },
            {
              "id": "4966ff45-09dd-422f-a44f-5c86f356a649",
              "name": "exportedAt",
              "value": "={{ $json.processedAt }}",
