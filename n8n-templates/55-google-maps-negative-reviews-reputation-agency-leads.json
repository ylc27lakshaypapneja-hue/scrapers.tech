  "nodes": [
    {
      "parameters": {
        "content": "## ⚡ Google Maps 1-3 Star Negative Review Monitor to Pitch Reputation Management\n\n**What this workflow does:**\nFind local businesses receiving unanswered 1-star or 2-star Google Maps reviews and automatically pitch reputation management.\n\n**Powered by Apify Actor:** [`laborious_rumor/google-maps-reviews-scraper`](https://apify.com/laborious_rumor/google-maps-reviews-scraper) (*First 1,000 results 100% Free — zero login cookies required!*)\n\n### Setup in 30 Seconds:\n1. Get your free Apify API token at [console.apify.com/settings/integrations](https://console.apify.com/settings/integrations).\n2. Open the **Run Apify Google Maps Reviews Scraper - Ratings & Text** HTTP Request node and replace `YOUR_APIFY_API_TOKEN` with your token.\n3. Click **Test Workflow** to extract live structured JSON records!",
        "height": 300,
        "width": 640
      },
      "id": "730895b3-20fe-46b7-ae1c-a56c0b672264",
      "name": "Sticky Note: Setup Instructions",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        180,
        80
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "fdc6f5c8-9841-4500-a5ca-0589bf301fe5",
      "name": "Daily Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        440
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "beaf8be7-d5f9-4cd9-aab2-0deabd6dbd1a",
              "name": "queries",
              "value": "[\"dental clinics Chicago recent reviews\",\"auto repair shops Miami reviews\"]",
              "type": "array"
            },
            {
              "id": "7a37c4c9-8b3b-432b-ac95-203af4a7cdf8",
