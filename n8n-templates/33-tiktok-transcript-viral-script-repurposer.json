          },
          "conditions": [
            {
              "id": "6cb246e2-cba5-471f-a0ee-2c1bff2eb7b6",
              "leftValue": "={{ $json.verifiedStatus ?? true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
