      "typeVersion": 3.4,
      "position": [
        440,
        460
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/laborious_rumor~google-ads-transparency-center-scraper/run-sync-get-dataset-items",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
