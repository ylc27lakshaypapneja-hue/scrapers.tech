          },
          "conditions": [
            {
              "id": "cb2dea47-31d2-4792-a591-bd75b149a5d3",
              "leftValue": "={{ $json.verifiedStatus ?? true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
