        "assignments": {
          "assignments": [
            {
              "id": "822ac3db-f9c8-44bc-a3ed-ba3bb0897bc4",
              "name": "queries",
              "value": "[\"fintech mobile app crash reviews\",\"AI note taking app feature requests\"]",
              "type": "array"
            },
            {
              "id": "37eff195-54f1-41ad-a41c-e56cd84a97c7",
