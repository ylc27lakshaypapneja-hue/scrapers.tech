        "assignments": {
          "assignments": [
            {
              "id": "c0968745-7b5b-4fc4-ae06-a53cbeccac7e",
              "name": "queries",
              "value": "[\"B2B SaaS marketing agencies New York\",\"managed IT services providers Austin TX\"]",
              "type": "array"
