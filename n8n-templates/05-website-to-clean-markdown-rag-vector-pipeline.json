      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f6e2a4d4-99c5-4e2e-ac23-8a05970d162d",
              "name": "queries",
              "value": "[\"https://docs.apify.com/platform/integrations/mcp\"]",
              "type": "array"
            },
            {
              "id": "a205447a-9469-45ec-a7fe-cd7184de9a0d",
              "name": "maxItems",
              "value": 25,
