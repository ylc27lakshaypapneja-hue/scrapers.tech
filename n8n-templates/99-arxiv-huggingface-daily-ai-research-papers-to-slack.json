        "options": {
          "timeout": 60000
        }
      },
      "id": "66e63296-dbfb-4664-ad97-9d2f0a760337",
      "name": "Run Apify arXiv & Hugging Face AI Paper Extractor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        460
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1127b51-814a-409e-afec-4723270a8d39",
              "leftValue": "={{ $json.verifiedStatus ?? true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6e29e5ab-f70c-4df2-afad-ea6145c288cd",
      "name": "Filter Verified Records",
      "type": "n8n-nodes-base.filter",
