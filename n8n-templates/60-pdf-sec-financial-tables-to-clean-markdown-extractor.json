          },
          "conditions": [
            {
              "id": "46249476-337d-4c22-a0c8-31358e6408c2",
              "leftValue": "={{ $json.verifiedStatus ?? true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "314edaae-ea42-495b-a50a-853a537766fc",
      "name": "Filter Verified Records",
