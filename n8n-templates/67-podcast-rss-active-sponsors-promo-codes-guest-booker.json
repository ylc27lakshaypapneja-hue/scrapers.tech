          },
          "conditions": [
            {
              "id": "18739f00-34e0-4e4a-a2c4-6cbb4c375e18",
              "leftValue": "={{ $json.verifiedStatus ?? true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
