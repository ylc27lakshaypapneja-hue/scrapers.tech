            "version": 2
          },
          "conditions": [
            {
              "id": "da54ce7c-c889-4efc-a630-34e300e26f90",
              "leftValue": "={{ $json.verifiedStatus ?? true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d04ea009-e8dc-4feb-adea-b85766ef55f5",
      "name": "Filter Verified Records",
