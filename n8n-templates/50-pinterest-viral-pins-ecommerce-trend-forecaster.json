      "id": "7819bc34-6472-48eb-a42b-2ba5b558221d",
      "name": "Run Apify Pinterest Scraper & Monitor Pins & Saves",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
