              "id": "0b158f2f-af93-4d29-a84a-7f863a4b61f2",
              "name": "queries",
              "value": "[\"B2B SaaS Founders San Francisco\",\"Agency Owners Chicago Illinois\"]",
              "type": "array"
            },
            {
              "id": "6c15cf5d-3060-499a-a2df-0f0e8f4a4732",
