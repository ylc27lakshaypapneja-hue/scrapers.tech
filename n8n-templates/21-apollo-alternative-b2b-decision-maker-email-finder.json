          },
          "conditions": [
            {
              "id": "2fb70e64-8921-4cc5-ab37-844fcee7e27f",
              "leftValue": "={{ $json.verifiedStatus ?? true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
