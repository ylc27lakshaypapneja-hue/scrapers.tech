          },
          "conditions": [
            {
              "id": "efc1b963-6670-4f2e-ade7-8614f98faa1a",
              "leftValue": "={{ $json.verifiedStatus ?? true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
