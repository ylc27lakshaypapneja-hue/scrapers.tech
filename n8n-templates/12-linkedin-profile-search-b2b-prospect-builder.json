      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "224f2a57-428b-4bb6-a6a9-57aca8e9e9b2",
              "name": "queries",
              "value": "[\"Head of Revenue Operations New York\",\"Founder AI SaaS Austin Texas\"]",
              "type": "array"
            },
            {
              "id": "9ac5f629-a2b0-4d22-a586-edbe89d1ed81",
              "name": "maxItems",
              "value": 25,
              "type": "number"
            },
            {
