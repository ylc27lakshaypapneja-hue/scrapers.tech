              "name": "tier",
              "value": "={{ $json.priorityTier }}",
              "type": "string"
            },
            {
              "id": "c58a3669-63e7-4e7d-a653-a53304141f67",
              "name": "exportedAt",
              "value": "={{ $json.processedAt }}",
