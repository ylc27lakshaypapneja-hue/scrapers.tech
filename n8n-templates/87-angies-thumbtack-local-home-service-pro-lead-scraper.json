          "conditions": [
            {
              "id": "a608ca62-dbcc-4fa1-a1f1-927a0f80aa2b",
              "leftValue": "={{ $json.leadQualityScore }}",
              "rightValue": 60,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
