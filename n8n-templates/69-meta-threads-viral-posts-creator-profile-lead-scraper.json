          "assignments": [
            {
              "id": "8fb4f824-a60d-4c9c-a700-91795c5bdc98",
              "name": "queries",
              "value": "[\"AI agents workflow automation\",\"DTC ecommerce founder threads\"]",
              "type": "array"
            },
            {
              "id": "b7cf95ba-983a-4877-a2e3-a81ad3fd845e",
