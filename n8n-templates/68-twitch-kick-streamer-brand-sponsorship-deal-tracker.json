        "assignments": {
          "assignments": [
            {
              "id": "b8d63aa1-7d17-45c2-ad54-b1180079c335",
              "name": "queries",
              "value": "[\"gaming peripherals sponsored streams\",\"energy drink creator sponsorships\"]",
              "type": "array"
            },
