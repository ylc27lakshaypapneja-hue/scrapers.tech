    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/laborious_rumor~producthunt-launch-upvote-maker-monitor/run-sync-get-dataset-items",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
