            "version": 2
          },
          "conditions": [
            {
              "id": "d0a544e3-24cf-4426-a1cd-73f22b52f2a3",
              "leftValue": "={{ $json.verifiedStatus ?? true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e75e8034-061c-4feb-a8f0-4e7059640ff4",
      "name": "Filter Verified Records",
